# Copy this file to .env and fill in your database connection string.
#
# Recommended: a local Postgres server on this same machine (see
# LOCAL_SETUP.md for install steps). No network dependency, no cold starts,
# no third-party outages — the database just runs alongside the app.
#
# Note: default port is 5432. If something else on your machine is already
# using it (e.g. a Docker Postgres container), Ubuntu's installer will
# assign the next free port (often 5433) instead — run `pg_lsclusters` to
# check which port your actual server is on if the connection fails.
DATABASE_URL=postgresql://tresbien:your_password@localhost:5432/tresbien_db

# Alternative: a cloud-hosted Postgres (Neon, Supabase, etc.), if you want
# your data reachable from another machine or device. Their connection
# strings look like:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Product photo storage — Cloudflare R2 (S3-compatible object storage).
# See LOCAL_SETUP.md for how to create these. Required; the app won't start
# without them.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=tresbien-photos
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
